/* ****************************************************************
   PROGRAM: OVRDRAFT
   PURPOSE: OVERDRAFT PROTECTION PROCESSOR - COMPANION PL/I SUBSYSTEM
            TO THE COBOL DEPOSIT/ACCOUNT-SERVICING MODULE. CHECKS
            WHETHER A WITHDRAWAL THAT WOULD OVERDRAW AN ACCOUNT CAN
            BE COVERED BY LINKED OVERDRAFT PROTECTION.
   **************************************************************** */

OVRDRAFT: PROCEDURE OPTIONS(MAIN);

   %INCLUDE OVRDCOM;

   DCL OD_REQUEST_FILE FILE RECORD INPUT;
   DCL OD_RESPONSE_FILE FILE RECORD OUTPUT;

   DCL ACCT_ID CHAR(10);
   DCL REQUESTED_AMT FIXED DECIMAL(9,2);
   DCL USES_THIS_MONTH FIXED BINARY(15);

   DCL 1 LINK_DATA,
         2 LINK_VALUE FIXED DECIMAL(5,2);
   /* LINK_DATA_OVLY SHARES THE SAME STORAGE AS LINK_DATA. WHEN THE
      ACCOUNT HAS NO OVERDRAFT LINK, THE SAME BYTES HOLD A DENIAL
      REASON CODE INSTEAD OF A LIMIT AMOUNT - PL/I'S DEFINED
      ATTRIBUTE IS THE EQUIVALENT OF COBOL'S REDEFINES. */
   DCL 1 LINK_DATA_OVLY DEFINED LINK_DATA,
         2 DENIAL_CODE CHAR(5);

   DCL LINK_OK BIT(1);
   DCL APPROVED BIT(1);
   DCL FEE_AMT FIXED DECIMAL(5,2);

   CALL INIT_PROC;
   CALL READ_REQUEST;
   CALL VALIDATE_LINK;
   IF LINK_OK THEN
      CALL CHECK_LIMIT;
   CALL WRITE_RESPONSE;
   CALL TERM_PROC;

   INIT_PROC: PROCEDURE;
      /* RULE: BEFORE PROCESSING, THE RESPONSE IS DEFAULTED TO
         DENIED SO A REQUEST THAT FAILS PARTWAY THROUGH NEVER COMES
         OUT APPROVED BY ACCIDENT. */
      OPEN FILE(OD_REQUEST_FILE);
      OPEN FILE(OD_RESPONSE_FILE);
      APPROVED = '0'B;
      LINK_OK = '0'B;
   END INIT_PROC;

   READ_REQUEST: PROCEDURE;
      READ FILE(OD_REQUEST_FILE) INTO(ACCT_ID, REQUESTED_AMT);
   END READ_REQUEST;

   VALIDATE_LINK: PROCEDURE;
      /* RULE: AN ACCOUNT WITH NO OVERDRAFT PROTECTION LINKED IS
         DENIED IMMEDIATELY, WITHOUT EVER CHECKING A LIMIT - THE
         SAME STORAGE THAT WOULD HOLD THE LIMIT HOLDS A DENIAL
         REASON CODE INSTEAD. */
      IF DENIAL_CODE = 'NOLNK' THEN
         LINK_OK = '0'B;
      ELSE
         LINK_OK = '1'B;
   END VALIDATE_LINK;

   CHECK_LIMIT: PROCEDURE;
      /* RULE: A REQUEST IS APPROVED ONLY IF THE REQUESTED AMOUNT IS
         WITHIN THE ACCOUNT'S LINKED OVERDRAFT LIMIT. */
      IF REQUESTED_AMT <= LINK_VALUE THEN
         DO;
            APPROVED = '1'B;
            CALL CALC_FEE;
         END;
      ELSE
         APPROVED = '0'B;
   END CHECK_LIMIT;

   CALC_FEE: PROCEDURE;
      /* RULE: THE FIRST OVERDRAFT PROTECTION USE IN A CALENDAR
         MONTH IS FREE. EVERY USE AFTER THAT IN THE SAME MONTH
         CHARGES A FLAT FEE. */
      IF USES_THIS_MONTH < OD_FREE_USES_PER_MONTH THEN
         FEE_AMT = OD_FEE_TIER1;
      ELSE
         FEE_AMT = OD_FEE_TIER2;
      CALL APPLY_FEE;
   END CALC_FEE;

   APPLY_FEE: PROCEDURE;
      /* RULE: THE OVERDRAFT FEE, ONCE CALCULATED, IS ADDED TO THE
         ACCOUNT'S RUNNING COUNT OF USES FOR THE MONTH. */
      USES_THIS_MONTH = USES_THIS_MONTH + 1;
   END APPLY_FEE;

   WRITE_RESPONSE: PROCEDURE;
      /* RULE: THE RESPONSE RECORD ALWAYS CARRIES THE APPROVAL FLAG
         AND THE FEE AMOUNT, EVEN WHEN THE FEE IS ZERO. */
      WRITE FILE(OD_RESPONSE_FILE) FROM(ACCT_ID, APPROVED, FEE_AMT);
   END WRITE_RESPONSE;

   TERM_PROC: PROCEDURE;
      CLOSE FILE(OD_REQUEST_FILE);
      CLOSE FILE(OD_RESPONSE_FILE);
   END TERM_PROC;

   /* DEAD CODE: NOT CALLED FROM ANYWHERE IN THIS PROGRAM. THIS WAS
      THE ORIGINAL FLAT-FEE CALCULATION, SUPERSEDED WHEN CALC_FEE
      STARTED WAIVING THE FIRST USE EACH MONTH. LEFT IN SOURCE,
      NEVER REMOVED - MUST NOT BE REPORTED AS A CURRENT RULE. */
   LEGACY_FLAT_FEE: PROCEDURE;
      FEE_AMT = OD_FEE_TIER2;
      CALL APPLY_FEE;
   END LEGACY_FLAT_FEE;

END OVRDRAFT;
