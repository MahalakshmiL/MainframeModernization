//DPBATCH  JOB (ACCTG),'MONTHLY BATCH',CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------*
//* MONTHLY DEPOSIT MODULE BATCH CHAIN
//* RUNS ACCOUNT MAINTENANCE, INTEREST CALCULATION, THEN
//* STATEMENT GENERATION, IN THAT ORDER, AGAINST THE SAME
//* ACCTMSTR VSAM FILE AND DB2 TABLES.
//*--------------------------------------------------------------*
//STEP010  EXEC PGM=ACCTMSTR
//STEPLIB  DD DSN=PROD.DEPOSIT.LOADLIB,DISP=SHR
//ACCTMSTR DD DSN=PROD.DEPOSIT.ACCTMSTR,DISP=SHR
//TRANLOG  DD DSN=PROD.DEPOSIT.TRANLOG,DISP=MOD
//CTLRPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC PGM=INTCALC,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=PROD.DEPOSIT.LOADLIB,DISP=SHR
//ACCTMSTR DD DSN=PROD.DEPOSIT.ACCTMSTR,DISP=SHR
//TRANLOG  DD DSN=PROD.DEPOSIT.TRANLOG,DISP=MOD
//SYSOUT   DD SYSOUT=*
//*
//STEP030  EXEC PGM=STMTGEN,COND=(4,LT,STEP020)
//STEPLIB  DD DSN=PROD.DEPOSIT.LOADLIB,DISP=SHR
//ACCTMSTR DD DSN=PROD.DEPOSIT.ACCTMSTR,DISP=SHR
//TRANLOG  DD DSN=PROD.DEPOSIT.TRANLOG,DISP=SHR
//STMTOUT  DD DSN=PROD.DEPOSIT.STMTOUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10)),DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
//*
//STEP040  EXEC PGM=IKJEFT01,COND=(4,LT,STEP030)
//*--------------------------------------------------------------*
//* UNLOAD UPDATED ACCOUNT / TRANSACTION DATA TO DB2 - SEE
//* DDLACCT.SQL FOR TARGET TABLE LAYOUTS AND FIELD MAPPING.
//*--------------------------------------------------------------*
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(DSNTIAUL) PLAN(DSNTIAUL) -
      LIB('PROD.DB2.RUNLIB.LOAD')
/*
